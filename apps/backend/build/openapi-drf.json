    "components": {
        "schemas": {
            "LessonDetail": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "description": {
                        "type": "string"
                    },
                    "order": {
                        "type": "integer",
                        "maximum": 2147483647,
                        "minimum": 0
                    },
                    "difficulty": {
                        "type": "integer",
                        "maximum": 2147483647,
                        "minimum": 0
                    },
                    "module": {
                        "type": "integer"
                    },
                    "code": {
                        "type": "string",
                        "readOnly": true
                    }
                },
                "required": [
                    "code",
                    "id",
                    "module",
                    "order",
                    "title"
                ]
            },
            "Me": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 254
                    },
                    "is_superuser": {
                        "type": "boolean",
                        "readOnly": true
                    },
                    "profile": {
                        "type": "string",
                        "readOnly": true
                    }
                },
                "required": [
                    "email",
                    "id",
                    "is_superuser",
                    "profile"
                ]
            },
            "Module": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "unit": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "order": {
                        "type": "integer",
                        "maximum": 2147483647,
                        "minimum": 0,
                        "default": 0
                    },
                    "lessons": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LessonDetail"
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "id",
                    "lessons",
                    "title",
                    "unit"
                ]
            },
            "Unit": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "order": {
                        "type": "integer",
                        "maximum": 2147483647,
                        "minimum": 0
                    },
                    "modules": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Module"
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "id",
                    "modules",
                    "title"
                ]
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid"
            }
        }
